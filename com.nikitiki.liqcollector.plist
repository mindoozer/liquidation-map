<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Always-on WS liquidation collector (OKX + Bybit). Install:
       cp com.nikitiki.liqcollector.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nikitiki.liqcollector.plist
     Manage:
       launchctl print gui/$(id -u)/com.nikitiki.liqcollector   (status)
       launchctl bootout gui/$(id -u)/com.nikitiki.liqcollector (stop/remove)
     KeepAlive restarts it on crash or network death; logs to collector.log. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nikitiki.liqcollector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec node /Users/nikitiki/code/claude-workspace/liquidation-map/collector.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/nikitiki/code/claude-workspace/liquidation-map</string>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/nikitiki/code/claude-workspace/liquidation-map/collector.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nikitiki/code/claude-workspace/liquidation-map/collector.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
